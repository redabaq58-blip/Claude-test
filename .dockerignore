# Version control
.git
.gitignore

# Local env files (never bake secrets into the image)
.env
.env.*
!.env.example

# Build artifacts (rebuilt inside Docker)
node_modules
**/node_modules
**/dist

# Dev/test files
*.test.ts
*.spec.ts
coverage
.nyc_output

# Editor & OS
.vscode
.idea
*.DS_Store
Thumbs.db

# Docs (not needed at runtime)
*.md
LICENSE

# CI
.github
