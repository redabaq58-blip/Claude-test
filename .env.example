# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# API Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=./data/claude-forge.db

# Optional: Default model override (opus|sonnet|haiku|auto)
DEFAULT_MODEL=auto

# Optional: Cost limit per run in USD (0 = unlimited)
COST_LIMIT_PER_RUN=0
