# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# API Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=./data/claude-forge.db

# Optional: Default model override (opus|sonnet|haiku|auto)
DEFAULT_MODEL=auto

# Optional: Cost limit per run in USD (0 = unlimited)
COST_LIMIT_PER_RUN=0

# Optional: Bearer token to protect all /api/* routes.
# Set this in any deployment that is reachable from the public internet.
# Clients must send:  Authorization: Bearer <value>
# Leave unset for local-only / private-network use.
API_SECRET=

# Optional: Allowed CORS origin for production deployments.
# Example: https://your-dashboard.vercel.app
# Leave unset to disable CORS entirely in production (safest default).
CORS_ORIGIN=
