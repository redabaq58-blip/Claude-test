{
  "name": "@claudeforge/cli",
  "version": "1.0.0",
  "description": "ClaudeForge CLI — run agents, manage workflows, and configure the platform from your terminal",
  "main": "dist/index.js",
  "bin": {
    "claude-forge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@claudeforge/core": "*",
    "@claudeforge/agents": "*",
    "@claudeforge/mcp": "*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2"
  }
}
